# Day84 Backend — Environment Variables
# ------------------------------------------------------------------
# Copy this file to .env and fill in real values before deploying.
# With no .env at all, the server still runs — invite emails are
# logged to the console instead of actually sent (see lib/email.js).

PORT=8787

# Resend (https://resend.com) — get an API key after verifying your
# sending domain. Without this set, emails are logged, not sent.
RESEND_API_KEY=

# Must be an address on a domain you've verified with Resend.
EMAIL_FROM="Day84 <invites@yourdomain.com>"

# Where the "Get Day84" button in the invite email points —
# your actual App Store / Play Store / landing page link.
APP_DOWNLOAD_URL=https://day84.app/download

# Base URL used to build the in-app "accept invite" link
# (yourdomain.com/invite/:token). Point this at your deployed
# web app or a universal-link-capable domain for native deep linking.
APP_WEB_BASE=https://day84.app
